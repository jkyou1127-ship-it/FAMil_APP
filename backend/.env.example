PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d
DB_PATH=./data/famil.db
CORS_ORIGIN=*

# 선택: 모바일 푸시 알림(FCM)을 쓰려면 Firebase 서비스 계정 키 파일 경로를 지정하세요.
# 기본값은 backend/firebase-service-account.json 입니다. 이 파일은 절대 커밋하지 마세요.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
